@page "/"
@using SearchDemonSlayerAPI.Models
@inject HttpClient Http

<PageTitle>SearchDemonSlayerAPI - Demon Slayer</PageTitle>

<div class="container py-2">
    <div class="text-center mb-4">
        <h1 class="display-6 fw-bold text-danger">Demon Slayer API ⚔️</h1>
        <p class="text-muted">Aplicação em Blazor WebAssembly (.NET 10+) para listar e buscar personagens de Kimetsu no Yaiba</p>
    </div>

    <!-- Barra de Busca e Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-7">
                    <label for="termoBusca" class="form-label fw-semibold">Nome do Personagem:</label>
                    <input type="text"
                           class="form-control"
                           id="termoBusca"
                           placeholder="Digite o nome (Ex: Tanjiro Kamado, Nezuko, Giyu...)"
                           @bind="termoBusca"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown" />
                </div>
                <div class="col-md-5 d-flex align-items-end gap-2">
                    <button class="btn btn-danger flex-grow-1" @onclick="BuscarPorNome" disabled="@carregando">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ListarPaginadoInicial" disabled="@carregando">
                        Listar Todos
                    </button>
                    @if (!string.IsNullOrWhiteSpace(termoBusca))
                    {
                        <button class="btn btn-outline-danger" @onclick="LimparBusca" title="Limpar pesquisa">
                            Limpar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Indicador de Carregamento -->
    @if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="mt-2 text-muted">Consultando a API de Demon Slayer...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-warning text-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @mensagemErro
        </div>
    }
    else if (personagens != null && personagens.Any())
    {
        <!-- Informações e Paginação (caso esteja no modo paginado) -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">
                Exibindo <strong>@personagens.Count</strong> personagem(ns)
                @if (modoPaginado && totalPaginas > 1)
                {
                    <span>(Página @paginaAtual de @totalPaginas)</span>
                }
            </span>

            @if (modoPaginado && totalPaginas > 1)
            {
                <div class="btn-group">
                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="PaginaAnterior"
                            disabled="@(paginaAtual <= 1 || carregando)">
                        &laquo; Anterior
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="ProximaPagina"
                            disabled="@(paginaAtual >= totalPaginas || carregando)">
                        Próxima &raquo;
                    </button>
                </div>
            }
        </div>

        <!-- Grade de Personagens -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            @foreach (var p in personagens)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <!-- Imagem do Personagem (img) -->
                        <div class="text-center p-3" style="background-color: #121214; border-top-left-radius: var(--bs-card-inner-border-radius); border-top-right-radius: var(--bs-card-inner-border-radius);">
                            <img src="@p.Img"
                                 alt="@p.Name"
                                 class="img-fluid rounded"
                                 style="max-height: 220px; object-fit: contain;"
                                 onerror="this.src='https://via.placeholder.com/220x220?text=Sem+Imagem';" />
                        </div>

                        <div class="card-body d-flex flex-column">
                            <!-- Nome (name) e Raça (race) -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark mb-0">@p.Name</h5>
                                <span class="badge @(p.Race == "Demon" ? "bg-danger" : "bg-primary")">
                                    @(p.Race == "Demon" ? "Demônio" : "Humano")
                                </span>
                            </div>

                            <!-- Idade (age) e Raça (race) -->
                            <ul class="list-unstyled small text-secondary mb-3">
                                <li>
                                    <strong>Idade:</strong>
                                    @(p.Age.HasValue ? $"{p.Age} anos" : "Desconhecida / Indeterminada")
                                </li>
                                <li>
                                    <strong>Raça:</strong> @p.Race
                                </li>
                                @if (!string.IsNullOrEmpty(p.Gender))
                                {
                                    <li>
                                        <strong>Gênero:</strong> @(p.Gender == "Male" ? "Masculino" : "Feminino")
                                    </li>
                                }
                            </ul>

                            <!-- Citação / Frase marcante (quote) -->
                            <div class="mt-auto p-2 bg-light rounded border-start border-4 border-danger">
                                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">
                                    CITAÇÃO / FRASE MARCANTE:
                                </small>
                                <em class="text-dark" style="font-size: 0.85rem;">
                                    “@(string.IsNullOrWhiteSpace(p.Quote) ? "Sem citação cadastrada." : p.Quote)”
                                </em>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (modoPaginado && totalPaginas > 1)
        {
            <div class="d-flex justify-content-center mb-5">
                <div class="btn-group">
                    <button class="btn btn-outline-danger"
                            @onclick="PaginaAnterior"
                            disabled="@(paginaAtual <= 1 || carregando)">
                        &laquo; Página Anterior
                    </button>
                    <span class="btn btn-danger disabled text-white">
                        Página @paginaAtual de @totalPaginas
                    </span>
                    <button class="btn btn-outline-danger"
                            @onclick="ProximaPagina"
                            disabled="@(paginaAtual >= totalPaginas || carregando)">
                        Próxima Página &raquo;
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center py-4">
            Nenhum personagem para exibir no momento. Digite um nome para buscar ou clique em "Listar Todos".
        </div>
    }
</div>

@code {
    private string termoBusca = string.Empty;
    private List<Character>? personagens = new();
    private bool carregando = false;
    private string? mensagemErro;

    // Controle de paginação
    private int paginaAtual = 1;
    private int totalPaginas = 1;
    private bool modoPaginado = true;

    protected override async Task OnInitializedAsync()
    {
        // Ao carregar a página pela primeira vez, lista os personagens da página 1
        await CarregarPagina(1);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarPorNome();
        }
    }

    private async Task BuscarPorNome()
    {
        if (string.IsNullOrWhiteSpace(termoBusca))
        {
            await ListarPaginadoInicial();
            return;
        }

        carregando = true;
        mensagemErro = null;
        modoPaginado = false;

        try
        {
            string url = $"https://www.demonslayer-api.com/api/v1/characters?name={Uri.EscapeDataString(termoBusca.Trim())}";
            var response = await Http.GetFromJsonAsync<DemonSlayerApiResponse>(url);

            if (response?.Content != null && response.Content.Any())
            {
                personagens = response.Content;
            }
            else
            {
                personagens = new();
                mensagemErro = $"Nenhum personagem encontrado com o termo \"{termoBusca}\".";
            }
        }
        catch (HttpRequestException)
        {
            personagens = new();
            mensagemErro = $"Nenhum personagem encontrado com o termo \"{termoBusca}\" na API de Demon Slayer.";
        }
        catch (Exception ex)
        {
            personagens = new();
            mensagemErro = $"Ocorreu um erro ao consultar a API: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task ListarPaginadoInicial()
    {
        termoBusca = string.Empty;
        await CarregarPagina(1);
    }

    private async Task CarregarPagina(int pagina)
    {
        carregando = true;
        mensagemErro = null;
        modoPaginado = true;

        try
        {
            string url = $"https://www.demonslayer-api.com/api/v1/characters?page={pagina}";
            var response = await Http.GetFromJsonAsync<DemonSlayerApiResponse>(url);

            if (response?.Content != null)
            {
                personagens = response.Content;
                if (response.Pagination != null)
                {
                    paginaAtual = response.Pagination.CurrentPage;
                    totalPaginas = response.Pagination.TotalPages;
                }
            }
            else
            {
                personagens = new();
                mensagemErro = "Não foi possível obter a lista de personagens.";
            }
        }
        catch (Exception ex)
        {
            personagens = new();
            mensagemErro = $"Erro ao carregar lista de personagens: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task ProximaPagina()
    {
        if (paginaAtual < totalPaginas)
        {
            await CarregarPagina(paginaAtual + 1);
        }
    }

    private async Task PaginaAnterior()
    {
        if (paginaAtual > 1)
        {
            await CarregarPagina(paginaAtual - 1);
        }
    }

    private async Task LimparBusca()
    {
        termoBusca = string.Empty;
        await CarregarPagina(1);
    }
}
